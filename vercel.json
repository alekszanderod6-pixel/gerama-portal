{
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "buildCommand": "echo 'GERAMA build 2026-08-30-fix-avatar'",
  "rewrites": [
    { "source": "/login",             "destination": "/login.html" },
    { "source": "/signup",            "destination": "/signup.html" },
    { "source": "/resources",         "destination": "/resources.html" },
    { "source": "/classroom",         "destination": "/classroom.html" },
    { "source": "/dashboard",         "destination": "/dashboard.html" },
    { "source": "/opportunities",     "destination": "/opportunities.html" },
    { "source": "/about",             "destination": "/about.html" },
    { "source": "/contact",           "destination": "/contact.html" },
    { "source": "/connect",           "destination": "/connect.html" },
    { "source": "/mall",              "destination": "/mall.html" },
    { "source": "/help",              "destination": "/help.html" },
    { "source": "/admin-dashboard",   "destination": "/admin-dashboard.html" },
    { "source": "/reset-code",        "destination": "/reset-code.html" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/js/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
